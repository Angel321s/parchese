{
  "name": "parchese",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Párchese: eventos, reservas y entradas para bares en Colombia, con pagos por Bre-B directo al bar.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-parchese",
    "seed": "node scripts/seed.js",
    "test:unit": "node --test tests/commission.test.js",
    "test:rules": "firebase emulators:exec --project demo-parchese --only firestore \"node --test tests/rules.test.js\"",
    "test:e2e": "node tests/e2e.js",
    "test": "npm run test:unit && npm run test:rules",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "firebase": "13.2.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "vite": "8.3.6"
  }
}
