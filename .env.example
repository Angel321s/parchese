# Copia este archivo como .env y pega los datos de la app web de tu proyecto de Firebase
# (en la consola de Firebase, en la configuración del proyecto, sección "Tus apps").
# Si lo dejas vacío, el sitio arranca en MODO DEMO: datos de ejemplo guardados solo en tu navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pon true para trabajar contra los emuladores locales (npm run emulators).
VITE_USE_EMULATORS=false
